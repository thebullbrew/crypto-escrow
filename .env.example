# Copy to .env and fill in. Never commit .env.

# Ethereum RPC endpoint (chain id 1).
# For production use a dedicated provider (Alchemy, Infura, QuickNode).
# Public fallback: https://eth.llamarpc.com
RPC_URL=

# Hex private key of the wallet running the scripts (64 chars, 0x prefix optional).
# Use a DEDICATED wallet, never your main wallet.
PRIVATE_KEY=

# Filled in after running the deploy script
CONTRACT_ADDRESS=

# Escrow parties (passed to the contract constructor on deploy)
BUYER=0x
SELLER=0x
ARBITER=0x

# Inspection window in days — the buyer may cancel for a refund until it closes
INSPECTION_DAYS=10

# Earnest money in ETH (decimal string, e.g. "1.5") — used by the fund script
AMOUNT_ETH=1.0
